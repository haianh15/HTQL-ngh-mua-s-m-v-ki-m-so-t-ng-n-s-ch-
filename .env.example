# Vercel server-only; never prefix with VITE_
# Current Supabase keys: sb_publishable_... for public, sb_secret_... for server.
# Keep the existing env variable names because V11 backend reads them.
# Legacy anon/service_role JWT keys also work. Do not commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVER_SECRET_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_SERVER_ONLY
GEMINI_MODEL=gemini-2.5-flash

# Exposed to the browser (public project settings, NOT secrets)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLIC_KEY
